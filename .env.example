# Example environment for docker-compose.prod.yml (FIN-032).
# MySQL runs on the host itself (systemd mysqld on port 3306): the `fincode`
# database and the `fincode`@`%` account were created once by the admin, so
# only the application password is needed here — no mysql root credentials.
# Copy to /opt/fincode/.env on the server and fill in real values — or let
# .github/workflows/deploy.yml write it from GitHub Actions secrets.
# Never commit real secrets (spec §68).

# --- Host MySQL: fincode@% application password ---
MYSQL_PASSWORD=change-me-host-mysql-fincode-password

# --- API auth ---
# Random string >= 32 chars, alphanumeric only (dotenv format has no quoting).
JWT_SECRET=change-me-32-chars-minimum-jwt-secret

# --- CORS: comma-separated browser origins allowed to call the API ---
CORS_ALLOWED_ORIGINS=http://43.153.80.15:3003

# --- PayPal billing (optional; billing stays disabled when empty) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_DEVELOPER=
PAYPAL_PLAN_STARTUP=
PAYPAL_PLAN_BUSINESS=
